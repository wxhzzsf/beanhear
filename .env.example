# Canonical production URL. Page metadata stays pinned to https://beanhear.com.
APP_URL=https://beanhear.com

# Set to the real App Store or TestFlight HTTPS URL when available.
# Leave empty to show the honest iOS availability placeholder.
APP_STORE_URL=

# Optional public alias; APP_STORE_URL takes precedence.
NEXT_PUBLIC_APP_STORE_URL=
