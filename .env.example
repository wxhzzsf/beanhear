# Canonical production URL. Page metadata stays pinned to https://beanhear.com.
APP_URL=https://beanhear.com

# Set to the real HTTPS URL of a published App Store or TestFlight listing.
# Leave empty to show the iOS app badge with no listing link.
APP_STORE_URL=

# Optional public alias; APP_STORE_URL takes precedence.
NEXT_PUBLIC_APP_STORE_URL=
